# ===============================
# OpenRouter Configuration (Primary AI Service)
# ===============================

OPENROUTER_API_KEY=sk-YOURAPIKEY
OPENROUTER_BASE_URL=https://openrouter.ai/api

# Một số gợi ý miễn phí:
# - meta-llama/llama-3.1-70b-instruct (rất mạnh, tương thích SpringAI)
# - mistralai/mixtral-8x7b
# - google/gemma-2-9b-it (nhẹ, chạy nhanh)
OPENROUTER_MODEL=meta-llama/llama-3.1-70b-instruct
OPENROUTER_TEMPERATURE=0.7
OPENROUTER_MAX_TOKENS=1000

# ===============================
# Gemini Configuration (Backup/Fallback - Optional)
# ===============================
GEMINI_API_KEY=

# ===============================
# Server Configuration
# ===============================
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev
